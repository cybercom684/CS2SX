<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<PackAsTool>true</PackAsTool>
		<ToolCommandName>cs2sx</ToolCommandName>
		<PackageId>CS2SX</PackageId>
		<!-- Runs on the newest installed .NET (8 or later) — users with only a newer SDK need no extra runtime. -->
		<RollForward>Major</RollForward>
		<!-- NuGet drops *.nupkg files by default — the tool must carry the bundled API package. -->
		<NoDefaultExcludes>true</NoDefaultExcludes>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
		<!-- Runtime headers: the interface every translation unit includes. -->
		<EmbeddedResource Include="Runtime\*.h" />
		<!-- Runtime modules: state + non-trivial functions, compiled once per tool version
		     (cached object files), exported to cs2sx_out/runtime/. -->
		<EmbeddedResource Include="Runtime\src\*.c" />
		<!-- The Switch API (src/CS2SX.Switch) — the very sources app projects compile
		     against via the CS2SX.Switch package. The transpiler analyses user code
		     against them, so IDE and transpiler can never disagree about the API. -->
		<EmbeddedResource Include="..\CS2SX.Switch\**\*.cs" Exclude="..\CS2SX.Switch\obj\**;..\CS2SX.Switch\bin\**">
			<LogicalName>CS2SX.Api.%(Filename)%(Extension)</LogicalName>
		</EmbeddedResource>
		<!-- Raw libnx bindings (generated, analysis only — not yet part of the package). -->
		<EmbeddedResource Include="Stubs\LibNX\**\*" />
	</ItemGroup>
	<ItemGroup>
		<Compile Remove="Stubs\**\*" />
		<Compile Remove="cs2sx_out\**\*" />
	</ItemGroup>

	<!-- Bundle the CS2SX.Switch package of the same version. `cs2sx new` points the new
	     project's nuget.config at it, so new projects build offline and always get the
	     API that matches this transpiler. -->
	<ItemGroup>
		<ProjectReference Include="..\CS2SX.Switch\CS2SX.Switch.csproj" ReferenceOutputAssembly="false" />
	</ItemGroup>
	<PropertyGroup>
		<CS2SXApiPackage>$(MSBuildThisFileDirectory)..\..\nupkg\CS2SX.Switch.$(Version).nupkg</CS2SXApiPackage>
	</PropertyGroup>
	<!-- An ordinary output file at packages/…: copied on build and publish, and therefore
	     also inside the dotnet-tool package (which is the tool's publish output). The
	     project reference above builds it first. -->
	<ItemGroup>
		<None Include="$(CS2SXApiPackage)" Link="packages\CS2SX.Switch.$(Version).nupkg"
		      CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
	</ItemGroup>
	<ItemGroup>
	  <Folder Include="Core\Models\" />
	</ItemGroup>
</Project>
