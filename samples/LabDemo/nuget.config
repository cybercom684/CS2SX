<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- CS2SX.Switch built from this repository (dotnet build src/CS2SX.Switch). -->
    <add key="cs2sx-repo" value="../../nupkg" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="cs2sx-repo">
      <package pattern="CS2SX.Switch" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
